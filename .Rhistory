set.seed(2013)    # Set seed for replicability
treatment <- 5         # Setting treatment effect
crisis <- -treatment   # Setting crisis effect
noise <- rnorm(1000, mean = 0, sd = 2)      # Adding random noise
exp_0 <- pmax(0, rnorm(1000, mean = 10, sd = 5))   # creating "experience" values
exp_1 <- pmax(0, rnorm(1000, mean = 10, sd = 5))   # Separate sample for post-test (not a panel design)
y_0 <- 40 + 2 * exp_0 + noise
y_1 <- 40 + 2 * exp_1 + treatment + crisis + noise
pop_0 <- data.frame(exp=exp_0, y=y_0, test = "Pre")
pop_1 <- data.frame(exp=exp_1, y=y_1, test = "Post")
pop <- pop_0 |>
rbind(pop_1)
pop$test <- factor(pop$test, levels = c("Pre", "Post"))
